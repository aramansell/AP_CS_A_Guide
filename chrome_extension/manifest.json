{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "Revision Banner for Google Docs — Teacher View",
  "short_name": "RevisionBanner",
  "version": "1.0.0",
  "description": "Shows Google Docs/Sheets/Slides revision history at a glance in a slim top banner: edits, active time, sessions, contributors, paste alerts and a writing-process score. All data stays on this machine.",
  "author": "AP CS A Guide",
  "permissions": ["storage", "unlimitedStorage", "identity", "tabs"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Revision Banner — class dashboard",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-banner": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Show or hide the Revision Banner on the current document"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/d/*",
        "https://docs.google.com/spreadsheets/d/*",
        "https://docs.google.com/presentation/d/*",
        "https://docs.google.com/forms/d/*",
        "https://docs.google.com/drawings/d/*"
      ],
      "js": ["content/main-world.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://docs.google.com/document/d/*",
        "https://docs.google.com/spreadsheets/d/*",
        "https://docs.google.com/presentation/d/*",
        "https://docs.google.com/forms/d/*",
        "https://docs.google.com/drawings/d/*",
        "https://drive.google.com/file/d/*"
      ],
      "js": ["content/banner.js"],
      "css": ["content/page-offset.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
