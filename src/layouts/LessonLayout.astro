---
/**
 * Lesson page layout.
 *
 * The prev/next chain is derived at build time from src/data/curriculum.ts
 * (LESSON_CHAIN) — the same single source of truth that drives the dashboard,
 * the pacing calendar, and the coverage matrix. Adding a lesson id to the
 * SEQUENCE automatically wires it into the chain everywhere; the old
 * scripts/rewire_nav.py regeneration step is gone.
 *
 * Also renders the per-student "I finished this lesson" progress toggle
 * (stored in localStorage, read back on the dashboard).
 */
import fs from 'node:fs';
import path from 'node:path';
import Base from './BaseLayout.astro';
import { LESSON_CHAIN } from '../data/curriculum';
import { LESSONS } from '../data/lessons';
import { CHECK_GATES, MASTER_TEACHER_PIN } from '../data/checkGates';
import { ANSWER_KEYS } from '../data/answerKeys';
import { formify } from '../lib/formify';

interface Props {
  /** lesson id, e.g. "4.2a" — must exist in LESSON_CHAIN */
  id: string;
  /** page <title>, verbatim from the original file */
  title: string;
  /** relative prefix to the site root */
  root: string;
  /** relative href of the stylesheet */
  css: string;
}
const { id, title, root, css } = Astro.props;

const i = LESSON_CHAIN.indexOf(id);
if (i === -1) {
  throw new Error(`Lesson "${id}" is not in LESSON_CHAIN (src/data/curriculum.ts SEQUENCE). Add it to the right day's lessons list so the chain, dashboard, and pacing calendar stay in sync.`);
}
const prev = i > 0 ? LESSON_CHAIN[i - 1] : null;
const next = i < LESSON_CHAIN.length - 1 ? LESSON_CHAIN[i + 1] : null;

// Form-ify the lesson body: every reflection question in a bug hunt,
// tinker challenge, or socratic checkpoint becomes a fillable answer box
// with a stable id. Rendered slot -> string -> transform -> set:html.
const rawBody = await Astro.slots.render('default');
const { html: formBody, questionCount } = formify(rawBody, id);
const meta = LESSONS[id];
const lessonTitle = meta?.title ?? id;
const targets = meta?.targets ?? [];
const h1CloseIdx = formBody.indexOf('</h1>');
const headingHtml = h1CloseIdx !== -1 ? formBody.slice(0, h1CloseIdx + 5) : '';
const restBodyHtml = h1CloseIdx !== -1 ? formBody.slice(h1CloseIdx + 5) : formBody;

function pinHash(s: string): string {
  let h = 0x811c9dc5;
  for (let k = 0; k < s.length; k++) {
    h ^= s.charCodeAt(k);
    h = Math.imul(h, 0x01000193);
  }
  return (h >>> 0).toString(16);
}

const gate = CHECK_GATES[id];
let encodedCheck = '';
let designKeysB64 = '';
let pinHashesJson = '[]';
let starterClass = '';
if (gate?.gatedOnPage) {
  const checkPath = path.resolve(process.cwd(), 'public', 'data', gate.checkFile);
  const rawBytes = fs.readFileSync(checkPath);
  const keyBytes = Buffer.from('apcsa-gate-' + id, 'utf8');
  const xored = Buffer.alloc(rawBytes.length);
  for (let idx = 0; idx < rawBytes.length; idx++) {
    xored[idx] = rawBytes[idx] ^ keyBytes[idx % keyBytes.length];
  }
  encodedCheck = xored.toString('base64');
  designKeysB64 = Buffer.from(JSON.stringify(ANSWER_KEYS[id] ?? {}), 'utf8').toString('base64');
  pinHashesJson = JSON.stringify([
    pinHash(gate.pin.toUpperCase()),
    pinHash(MASTER_TEACHER_PIN.toUpperCase()),
  ]);
  starterClass = gate.starterFile.replace(/\.java$/, '');
}
---
<Base title={title} active="dashboard" root={root} docsHome={root + '/docs/index.html'} css={css}
  description={"Lesson " + id + " " + lessonTitle + " — AP CS A. Predict-first labs, bug hunts, and checkpoints with answer boxes you can download and turn in."}>
  <div class="lesson-nav" data-pagefind-ignore>
    {prev ? <a href={prev + '.html'}>&#9664; {prev}</a> : <span></span>}
    <span class="lesson-id">{id}</span>
    {next ? <a href={next + '.html'}>{next} &#9654;</a> : <span></span>}
  </div>

  <header class="lesson-header">
    <Fragment set:html={headingHtml} />
    {targets.length > 0 && (
      <div class="lesson-targets" aria-label="Learning Targets and Success Criteria">
        <div class="lesson-targets-head">
          <span class="lesson-targets-kicker">Learning Targets &amp; Success Criteria</span>
          {meta && <span class={`badge ${meta.badgeClass}`}>{meta.badgeLabel}</span>}
        </div>
        <ol class="lesson-targets-list">
          {targets.map((t, idx) => (
            <li class="lesson-target-item">
              <div class="target-row">
                <span class="target-pill">LT {idx + 1}</span>
                <span class="target-text"><strong>Learning Target:</strong> {t.target}</span>
              </div>
              <div class="criteria-row">
                <span class="criteria-pill">SC {idx + 1}</span>
                <span class="criteria-text"><strong>Success Criteria:</strong> {t.criteria}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    )}
  </header>

  <Fragment set:html={restBodyHtml} />

  {gate?.gatedOnPage && (
    <section
      class="check-gate"
      id="check-gate"
      data-lesson={id}
      data-check-file={gate.checkFile}
      data-payload={encodedCheck}
      data-keys={designKeysB64}
      data-pin-hashes={pinHashesJson}
      data-pagefind-ignore
    >
      <h2>One-Shot Acceptance Challenge: Unlock <code>{gate.checkFile}</code></h2>
      <p>
        Complete at least 75% of the Guided Design &amp; Code Draft boxes above and test your methods by running{' '}
        <code>{gate.sandboxCmd ?? ('java ' + starterClass)}</code> in your terminal first. When your code is ready to pass
        on the very first run, verify your design below (or enter a Teacher PIN) to unlock{' '}
        <code>{gate.checkFile}</code>.
      </p>
      <div class="gate-actions">
        <button type="button" class="gate-verify-btn" id="gate-verify-btn">
          Verify My Design &amp; Unlock {gate.checkFile}
        </button>
        <div class="gate-pin-row">
          <label for="gate-pin-input">Teacher PIN:</label>
          <input type="text" id="gate-pin-input" placeholder="Enter PIN" autocomplete="off" />
          <button type="button" class="gate-pin-btn" id="gate-pin-btn">Unlock with PIN</button>
        </div>
      </div>
      <div class="gate-feedback" id="gate-feedback" hidden></div>
      <div class="gate-unlocked" id="gate-unlocked" hidden>
        <span class="gate-unlocked-badge">Unlocked &middot; Ready for Your One-Shot Verification</span>
        <div class="gate-unlocked-row">
          <button type="button" class="gate-download-btn" id="gate-download-btn">
            Download {gate.checkFile}
          </button>
          <span class="lab-note" style="margin:0;">Save it into the same folder as <code>{gate.starterFile}</code> and run:</span>
        </div>
        <pre><code>{gate.compileCmd}</code></pre>
      </div>
    </section>
  )}

  {questionCount > 0 && (
    <div class="lab-bar" data-lesson={id} data-lesson-title={lessonTitle} data-count={questionCount} data-pagefind-ignore>
      <div class="lab-bar-row">
        <label class="lab-name">Student name
          <input id="lab-student" type="text" autocomplete="name" placeholder="First Last" />
        </label>
        <span class="lab-count" id="lab-count">0/{questionCount} answered</span>
        <button type="button" class="lab-download" id="lab-download">Download answers (.json)</button>
      </div>
      <p class="lab-note">
        Answers save on this device as you type. At the end of class, click
        Download and upload the file to the Canvas assignment.
      </p>
    </div>
  )}

  <label class="progress-toggle" data-lesson={id} data-pagefind-ignore>
    <input type="checkbox" />
    <span>I finished this lesson</span>
  </label>
  <p class="progress-note" data-pagefind-ignore>Saved on this device only — the Dashboard tracks your progress.</p>

  <nav class="lesson-foot" data-pagefind-ignore aria-label="Lesson navigation">
    {prev ? (
      <a class="foot-prev" href={prev + '.html'}>
        <span class="dir">&#9664; Previous</span>
        <span class="where">{prev} — {LESSONS[prev]?.title}</span>
      </a>
    ) : <span></span>}
    {next ? (
      <a class="foot-next" href={next + '.html'}>
        <span class="dir">Next &#9654;</span>
        <span class="where">{next} — {LESSONS[next]?.title}</span>
      </a>
    ) : (
      <a class="foot-next" href={root + '/index.html'}>
        <span class="dir">Course complete &#9654;</span>
        <span class="where">Back to the Dashboard</span>
      </a>
    )}
  </nav>
</Base>

<script src={root + '/js/lab-forms.js'} is:inline></script>

<script>
  // Lesson progress tracker — plain localStorage, no dependencies.
  const KEY = 'apcsa-progress';
  const read = (): Record<string, boolean> => {
    try { return JSON.parse(localStorage.getItem(KEY) ?? '{}'); } catch { return {}; }
  };

  const label = document.querySelector('.progress-toggle');
  const box = label?.querySelector('input');
  if (label && box) {
    const id = label.dataset.lesson ?? '';
    const sync = () => label.classList.toggle('done', box.checked);
    box.checked = !!read()[id];
    sync();
    box.addEventListener('change', () => {
      const data = read();
      data[id] = box.checked;
      localStorage.setItem(KEY, JSON.stringify(data));
      sync();
    });
  }
</script>
