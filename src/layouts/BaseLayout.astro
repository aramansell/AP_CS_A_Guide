---
/**
 * Base layout — the shell every page on the site shares.
 *
 * Before the Astro migration this markup was duplicated by hand in all 310
 * HTML files (a nav change meant a 310-file find-and-replace). Now it lives
 * here exactly once.
 *
 * Props:
 *   title    - page <title>, verbatim (may contain HTML entities)
 *   active   - which top-nav tab is highlighted
 *   root     - relative prefix to the site root ('' | '..' | '../..')
 *   docsHome - relative href to docs/index.html (differs inside docs/)
 *   css      - relative href of the stylesheet this page always used
 */
interface Props {
  title: string;
  active?: 'dashboard' | 'docs' | 'projects' | 'exam' | 'search';
  root: string;
  docsHome: string;
  css: string;
  /** page description for <meta> / social previews (optional) */
  description?: string;
}
const { title, active, root, docsHome, css, description } = Astro.props;
const desc = description ?? 'AP CS A study guide — lessons, reference docs, and exam prep.';
// title props are verbatim (may contain entities like &amp;) — decode to
// plain text so attribute interpolation doesn't double-escape them.
const plainTitle = title
  .replace(/&amp;/g, '&')
  .replace(/&lt;/g, '<')
  .replace(/&gt;/g, '>')
  .replace(/&quot;/g, '"')
  .replace(/&#39;/g, "'");

const tabs = [
  { key: 'dashboard', href: `${root ? root + '/' : ''}index.html`, label: 'Dashboard' },
  { key: 'docs', href: docsHome, label: 'Docs' },
  { key: 'projects', href: `${root ? root + '/' : ''}projects.html`, label: 'Projects' },
  { key: 'exam', href: `${root ? root + '/' : ''}exam/index.html`, label: 'Exam' },
  { key: 'search', href: `${root ? root + '/' : ''}search.html`, label: 'Search' },
] as const;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title set:html={title}></title>
<meta name="description" content={desc}>
<meta property="og:title" content={plainTitle} />
<meta property="og:description" content={desc} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="AP CS A Guide" />
<link rel="icon" type="image/svg+xml" href={(root ? root + '/' : '') + 'favicon.svg'} />
<link rel="stylesheet" href={css}>
</head>
<body>

<a class="skip-link" href="#main-content">Skip to content</a>

<nav class="top-nav" data-pagefind-ignore>
    {tabs.map((t) => <a href={t.href} class={t.key === active ? 'active' : undefined} aria-current={t.key === active ? 'page' : undefined}>{t.label}</a>)}
</nav>

<div class="page" id="main-content">
    {Astro.slots.has('breadcrumb') && <slot name="breadcrumb" />}
    <slot />
</div><!-- .page -->

<script is:inline>
(function () {
  function copyText(text, btn, emptyLabel) {
    var val = text == null ? '' : String(text);
    if (!val.trim()) {
      flash(btn, emptyLabel || 'Empty');
      return;
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(val).then(function () {
        flash(btn, 'Copied!');
      }, function () {
        fallbackCopy(val, btn);
      });
    } else {
      fallbackCopy(val, btn);
    }
  }

  function fallbackCopy(val, btn) {
    var ta = document.createElement('textarea');
    ta.value = val;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed';
    ta.style.left = '-9999px';
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      flash(btn, 'Copied!');
    } catch (e) {
      flash(btn, 'Failed');
    }
    ta.remove();
  }

  function flash(btn, label) {
    if (!btn.dataset.origText) btn.dataset.origText = btn.textContent;
    btn.textContent = label;
    btn.classList.toggle('copied', label === 'Copied!');
    clearTimeout(btn._copyTimer);
    btn._copyTimer = setTimeout(function () {
      btn.textContent = btn.dataset.origText;
      btn.classList.remove('copied');
    }, 1500);
  }

  document.querySelectorAll('pre').forEach(function (pre) {
    if (pre.parentElement && pre.parentElement.classList.contains('pre-wrap')) return;
    var wrap = document.createElement('div');
    wrap.className = 'pre-wrap';
    pre.parentNode.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'pre-copy-btn';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy code');
    btn.setAttribute('data-pagefind-ignore', '');
    btn.addEventListener('click', function () {
      var codeEl = pre.querySelector('code');
      var raw = (codeEl ? codeEl.textContent : pre.textContent) || '';
      copyText(raw.replace(/\n$/, ''), btn);
    });
    wrap.appendChild(btn);
  });

  document.addEventListener('click', function (e) {
    var labBtn = e.target.closest('.lab-copy-btn');
    if (labBtn) {
      var qid = labBtn.getAttribute('data-copy-for');
      var ta = qid ? document.getElementById('ans-' + qid) : null;
      if (!ta) {
        var field = labBtn.closest('.lab-field');
        ta = field ? field.querySelector('textarea.lab-answer') : null;
      }
      copyText(ta ? ta.value : '', labBtn, 'Empty');
      return;
    }
    var directBtn = e.target.closest('[data-copy-text]');
    if (directBtn) {
      copyText(directBtn.getAttribute('data-copy-text') || '', directBtn);
    }
  });
})();
</script>

</body>
</html>
