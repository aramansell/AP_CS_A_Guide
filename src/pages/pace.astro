---
// Pacing Calendar — rebuilt at every `npm run build` from
// src/data/curriculum.ts. The main Dashboard (index.html) now includes this
// full schedule with progress tracking; pace.html remains available as a
// compact single-table printable view with direct lesson links.
import Base from '../layouts/BaseLayout.astro';
import { SEQUENCE, DAY_NOTES, KIND_LABEL, EXAM_DATE, EXAM_TIME, CED_TOPICS, prettyDate, longDate } from '../data/curriculum';

const NBSP = '\u00A0';
---
<Base title="Pacing Calendar 2026-27 — AP CS A" active="dashboard" root="" docsHome="docs/index.html" css="style.css">
<h1>Pacing Calendar, 2026-27</h1>

<div class="callout">
    <strong>Unified Dashboard:</strong> The <a href="index.html">Dashboard</a>
    now combines this day-by-day pacing schedule with your lesson progress
    and one-click build links. This page provides the compact full-year print
    view.
</div>

<p>
    Every A-day of the school year, mapped to its work. Built from the PPS
    district calendar and our A/B alternation. All {Object.keys(CED_TOPICS).length}
    required CED topics are covered by April 8, followed by a one-month AP Exam
    Prep &amp; Testing Sprint leading into the <strong>exam on {longDate(EXAM_DATE)} at {EXAM_TIME}</strong>.
</p>

<table class="pace-table">
    <tr><th>Date</th><th>Type</th><th>Unit</th><th>What we do</th><th>CED topics</th></tr>
    {SEQUENCE.map((e) => {
        const notes: string[] = [];
        if (DAY_NOTES[e.d] && e.note) {
            notes.push(DAY_NOTES[e.d], e.note);
        } else if (DAY_NOTES[e.d]) {
            notes.push(DAY_NOTES[e.d]);
        } else if (e.note) {
            notes.push(e.note);
        }
        return (
        <tr class={`kind-${e.kind}`}>
            <td>{prettyDate(e.d)}</td>
            <td>{KIND_LABEL[e.kind]}</td>
            <td>{e.group}</td>
            <td>
                {e.lessons.length === 1 ? (
                    <a href={`lessons/${e.lessons[0]}.html`}><strong>{e.title}</strong></a>
                ) : (
                    <>
                        <strong>{e.title}</strong>
                        {e.lessons.length > 1 && (
                            <span style="margin-left:0.4rem; font-size:12px;">
                                ({e.lessons.map((lid, idx) => (
                                    <>{idx > 0 && ', '}<a href={`lessons/${lid}.html`}>{lid}</a></>
                                ))})
                            </span>
                        )}
                    </>
                )}
                {e.new && <span class="badge discovery" style="margin-left:.5rem">NEW</span>}
                {notes.map((n) => <><br /><span class="day-note">{n}</span></>)}
            </td>
            <td class="ced">{e.ced.length ? e.ced.join(', ') : NBSP}</td>
        </tr>
        );
    })}
</table>
</Base>

<style>
.pace-table td { font-size: 13px; padding: 0.45rem 0.6rem; }
.pace-table .ced { color: var(--muted); font-size: 12px; }
.day-note { color: var(--muted); font-size: 12px; }
tr.kind-exam td { background: rgba(224,85,85,0.10); font-weight: 600; }
tr.kind-test td, tr.kind-mock td { background: rgba(232,184,75,0.07); }
tr.kind-frq td { background: rgba(92,175,255,0.07); }
tr.kind-clinic td { background: rgba(185,142,255,0.07); }
tr.kind-season2 td, tr.kind-capstone td { background: rgba(240,160,96,0.07); }
</style>
