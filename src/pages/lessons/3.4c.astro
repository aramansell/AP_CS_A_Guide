import Lesson from '../../layouts/LessonLayout.astro';

const body = `<h1>3.4c — Command Interpreter: Text-Driven Combat</h1>

<!-- ============================================================ -->
<div class="activity expand-app">
    <div class="activity-header">
        <span class="activity-label">Expand Application</span>
        <span class="activity-time">~30 min</span>
    </div>

    <div class="section">
        <h3>Build: Combat Command Parser</h3>
        <p>Text-based games let players type commands like "attack", "defend", or "flee". Your job is to build the parser that interprets those commands — using everything you know about String comparison and if/else-if.</p>
        <p>Create a class called <code>CommandInterpreter</code>. Hardcode a <code>String command</code> (test with "attack", "ATTACK", "defend", "flee", "dance", and a misspelling).</p>
    </div>

    <div class="section">
        <h3>Rules</h3>
        <ol>
            <li>Use <code>.equalsIgnoreCase()</code> so "attack", "Attack", and "ATTACK" all work.</li>
            <li>"attack" → print damage dealt (hardcode a number).</li>
            <li>"defend" → print "You brace for impact. Damage reduced by 50%."</li>
            <li>"flee" → print "You attempt to escape!" then check a <code>boolean canFlee</code> variable — if true, escape; if false, "The enemy blocks your path!"</li>
            <li>"status" → print current HP and MP (hardcoded values).</li>
            <li>Anything else → print "Unknown command. Try: attack, defend, flee, status."</li>
        </ol>
        <p>
            <code>equalsIgnoreCase()</code> is not on the
            <a href="../exam/java-quick-reference.html">Java Quick Reference</a>. The
            sheet's shape for it lowercases both sides and compares with
            <code>equals</code>: <code>command.toLowerCase().equals("attack")</code>.
            Be aware that <code>toLowerCase()</code> is off the sheet as well and has no
            substitute of its own, so a question that needs case-insensitive matching
            will usually hand you the lowercased text and let you do the comparison.
        </p>
    </div>

    <div class="section">
        <h3>Extend: Command Prefixes</h3>
        <p>What if a player types "attack goblin"? Use <code>.startsWith("attack")</code> to detect attack commands that include a target. Print "You attack the [target]!" by extracting the target from the command string.</p>
        <p>
            <code>startsWith()</code> is off the sheet too. The sheet's version asks where
            the prefix sits: <code>command.indexOf("attack") == 0</code>, using the same
            fact the JQR page's <code>contains</code> row turns on, that <code>0</code>
            means found at the very start. Or spell it out:
            <code>command.substring(0, 6).equals("attack")</code>.
        </p>
    </div>
</div>

<div class="resources">
    <h3>Reference Docs</h3>
    <ul>
        <li><a href="../docs/unit-03/comparing-objects.html">Comparing Objects</a></li>
        <li><a href="../docs/unit-02/string.html">String Methods</a></li>
        <li><a href="../docs/unit-03/boolean-logic.html">Booleans &amp; if Statements</a></li>
    </ul>
</div>`;
---
<Lesson id="3.4c" title="3.4c Command Interpreter — AP CS A" root=".." css="../style.css">
  <Fragment set:html={body} />
</Lesson>
