import Lesson from '../../layouts/LessonLayout.astro';

const body = `<h1>6.2a — Array Traversal: Walking the Row</h1>

<div class="activity discovery">
    <div class="activity-header">
        <span class="activity-label">Discovery Lab</span>
        <span class="activity-time">~25 min</span>
    </div>

    <p>
        Yesterday you accessed array elements one at a time. But printing 100
        elements with 100 println statements is insanity. You need to <strong>walk the
        array</strong> — visit every element in order using a loop. This is called
        <strong>traversal</strong>.
    </p>

    <div class="tinker">
        <h3>Experiment: For-Loop Traversal</h3>
        <p>Create <code>ArrayWalk.java</code>. Try each pattern:</p>
        <pre><code>int[] scores = {95, 87, 72, 100, 63};

// Pattern 1: standard for loop
for (int i = 0; i < scores.length; i++) {
    System.out.println("scores[" + i + "] = " + scores[i]);
}

// Pattern 2: enhanced for loop (for-each)
for (int score : scores) {
    System.out.println(score);
}</code></pre>
        <p>Run both. Answer: what's the difference? When would you use each?</p>
    </div>

    <div class="tinker">
        <h3>Experiment: Modify During Traversal</h3>
        <pre><code>// Double every score
for (int i = 0; i < scores.length; i++) {
    scores[i] = scores[i] * 2;
}

// Try the same with for-each:
for (int score : scores) {
    score = score * 2;  // Does this change the array?
}
// Print the array after each attempt. What happened?</code></pre>
    </div>

    <div class="callout trap">
        <strong>For-Each Modification Trap:</strong> Enhanced for loops give
        you a COPY of each element. Modifying <code>score</code> doesn't change
        the array. If you need to modify elements, use the standard for loop
        with an index. Read the <a href="../docs/unit-06/array-traversal.html">
        Array Traversal docs</a> for the full explanation.
    </div>

    <div class="tinker">
        <h3>Build: Statistics Calculator</h3>
        <p>Create <code>ArrayStats.java</code>:</p>
        <ul>
            <li>Hard-code an array of 8 test scores: {88, 92, 75, 64, 100, 83, 77, 91}</li>
            <li>Traverse to compute: sum, average (as double!), minimum, maximum</li>
            <li>Count how many scores are above average</li>
            <li>Print all results with labels</li>
        </ul>
    </div>

    <div class="socratic">
        <h3>Socratic Checkpoint</h3>
        <ol>
            <li>You computed average as a double. Why? What happens if you use int
            for the average — what data do you lose?</li>
            <li>Look at the <a href="../docs/unit-06/array-traversal.html">traversal docs</a>
            section on reverse traversal. Why would you ever want to go backwards
            through an array?</li>
            <li>If your array has 100,000 elements, would your for-loop traversal
            still work? What about the for-each? Is one faster?</li>
        </ol>
    </div>

    <div class="checklist">
        <h3>Checkpoint — before moving on, you must be able to:</h3>
        <ul>
            <li>Traverse an array with both standard for and enhanced for</li>
            <li>Compute sum, average, min, max during a single pass</li>
            <li>Explain when for-each CANNOT replace standard for</li>
            <li>Count elements matching a condition during traversal</li>
        </ul>
    </div>
</div>

<div class="resources">
    <h3>Reference Docs</h3>
    <ul>
        <li><a href="../docs/unit-06/array-traversal.html">Array Traversal</a> — for, for-each, reverse</li>
        <li><a href="../docs/unit-06/array-basics.html">Array Basics</a> — review if indexing is fuzzy</li>
    </ul>
</div>`;
