import Lesson from '../../layouts/LessonLayout.astro';

const body = `<h1>1.6b — Random Tip Generator</h1>

<!-- ============================================================ -->
<div class="activity expand-app">
    <div class="activity-header">
        <span class="activity-label">Expand Application</span>
        <span class="activity-time">~15 min</span>
    </div>

    <p>Sometimes you want to leave a random tip just for fun. Add a random tip mode.</p>

    <ol>
        <li>Replace the hardcoded <code>tipPercent</code> with a random value from
            10 to 30 (inclusive).</li>
        <li>Print the randomly selected tip percentage so the user can see it.</li>
        <li>Run the program multiple times — does it feel unfair? Why might you
            want a fixed percentage instead?</li>
    </ol>

    <div class="tinker">
        <h3>Tinker: Two Modes</h3>
        <p>
            Add a <code>boolean randomMode = true;</code> variable. If it's true,
            use the random tip percentage. If false, use the hardcoded one. Test
            both modes.
        </p>
    </div>

    <div class="socratic">
        <h3>Socratic Checkpoint</h3>
        <p>
            You just combined two concepts — random number generation and the tip
            calculator — that you learned separately. What other concepts could you
            combine with the tip calculator? An RPG-themed tip calculator?
            A tip calculator that prints ASCII art receipts?
        </p>
    </div>
</div>

<!-- ============================================================ -->
<div class="resources">
    <h3>Reference Docs</h3>
    <ul>
        <li><a href="../docs/unit-01/math-random.html">Math.random()</a></li>
        <li><a href="../docs/unit-01/tip-calculator.html">Tip Calculator Walkthrough</a></li>
    </ul>
</div>`;
---
<Lesson id="1.6b" title="1.6b Random Tip Generator — AP CS A" root=".." css="../style.css">
  <Fragment set:html={body} />
</Lesson>
